# Keep build contexts small and make sure local secrets/data never enter an image.
.git/
.agents/
.claude/
node_modules/
frontend/node_modules/
dist/
.vite/
.env
.env.*
!.env.example
docker/.env.*
!docker/.env.production.example
!docker/.env.local.example
orbit-hrms-api/.env
orbit-hrms-api/.env.*
!orbit-hrms-api/.env.example
orbit-hrms-api/vendor/
orbit-hrms-api/node_modules/
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.*
!backend/.env.example
orbit-hrms-api/storage/logs/
orbit-hrms-api/storage/framework/
orbit-hrms-api/storage/tenant*/
orbit-hrms-api/bootstrap/cache/*.php
coverage/
