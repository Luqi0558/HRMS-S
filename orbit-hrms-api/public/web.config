<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS equivalent of the .htaccess beside it.

    IIS ignores .htaccess entirely, so without this file only the default
    document works: https://host/ serves Laravel's welcome page while every
    real route returns an IIS 404. In a browser that reads as a CORS error
    rather than a 404, because an IIS error page carries no
    Access-Control-Allow-Origin header and the request fails the CORS check
    before the status code is ever surfaced.

    Requires the IIS "URL Rewrite" module (iis.net/downloads/microsoft/url-rewrite).
    Without it IIS returns a 500.19 on every request instead.
-->
<configuration>
    <system.webServer>

        <!--
            OPTIONS is the CORS preflight. IIS answers it itself by default,
            with its own Allow: header and no CORS headers at all, so every
            cross-origin POST from the frontend fails before the real request
            is sent. WebDAV does the same to other verbs. Both are removed so
            the request reaches PHP and Laravel's CORS middleware replies.
        -->
        <handlers>
            <remove name="WebDAV" />
            <remove name="OPTIONSVerbHandler" />
        </handlers>
        <modules>
            <remove name="WebDAVModule" />
        </modules>

        <rewrite>
            <rules>
                <!-- Strip a trailing slash from anything that is not a real directory. -->
                <rule name="Laravel: no trailing slash" stopProcessing="true">
                    <match url="^(.*)/$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
                </rule>

                <!--
                    Everything that is not an existing file or directory goes to
                    the front controller. Real assets (robots.txt, favicon) are
                    still served directly by the two negated conditions.
                -->
                <rule name="Laravel: front controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <!--
            Uploaded documents and check-in photos are posted as multipart form
            data. IIS caps a request body at 28.6 MB by default, and the API
            already permits a 10 MB document, so the ceiling is raised to keep
            the two from disagreeing. maxAllowedContentLength is in bytes.
        -->
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="52428800" />
            </requestFiltering>
        </security>

        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

    </system.webServer>
</configuration>
