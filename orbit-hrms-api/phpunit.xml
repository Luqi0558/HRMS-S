<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- A real broadcaster so channel authorisation callbacks are
             registered: the null driver authorises every channel, which would
             make the channel-auth test assert nothing. Tests\TestCase swaps
             in a Pusher client that never sends, and these keys are fakes, so
             no test can reach the production Pusher app whatever .env holds. -->
        <env name="BROADCAST_DRIVER" value="pusher"/>
        <env name="PUSHER_APP_ID" value="test-app" force="true"/>
        <env name="PUSHER_APP_KEY" value="test-key" force="true"/>
        <env name="PUSHER_APP_SECRET" value="test-secret" force="true"/>
        <env name="PUSHER_HOST" value="127.0.0.1" force="true"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
