# Copy to .env and adjust. Vite only exposes variables prefixed with VITE_.

# Laravel API base URL.
VITE_API_URL=http://127.0.0.1:8000/api

# Which company (tenant) this build talks to. The API resolves tenancy from
# the X-Tenant header, so every request carries this value.
#
# Single-company deployments can hardcode it here. If you later need several
# companies from one build, this becomes a field on the login form or is
# derived from the subdomain — see apiClient.setTenant().
VITE_TENANT=orbit

# --- Realtime (optional) ----------------------------------------------------
# Pusher Channels, from dashboard.pusher.com -> your app -> App Keys.
#
# Leave these blank and the app runs on polling alone: new messages and
# notifications arrive within ~3 seconds instead of instantly. That is a
# supported mode, not a degraded one — Pusher only accelerates a feed the
# poll already delivers.
#
# ONLY the key and cluster belong here. Vite bakes every VITE_ variable into
# the built JavaScript, so the app secret must never appear in this file — it
# stays in the API's .env, where the browser cannot read it.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap2
